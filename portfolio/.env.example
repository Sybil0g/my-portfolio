# ------------------------------------------------------------------
# Copy this file to ".env" and fill in the values from your Firebase
# project settings (Project settings > General > Your apps > SDK setup).
# Never commit the real ".env" file — it's already in .gitignore.
#
# When you deploy to Vercel, add these SAME variables in:
# Vercel Dashboard > your project > Settings > Environment Variables
# ------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
